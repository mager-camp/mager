generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id               String         @id @default(uuid())
  roleId           Int
  fullName         String
  email            String         @unique
  phone            String?
  passwordHash     String
  profilePicture   String?
  isPremium        Boolean        @default(false)
  premiumExpiredAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  createdCourses   Course[]       @relation("CreatedCourses")
  notifications    Notification[]
  payments         Payment[]
  role             Role           @relation(fields: [roleId], references: [id])
  instructor       Instructor?
  moduleProgress   UserModuleProgress[]
  userCourses      UserCourse[]
  schedules        UserSchedule[]
  workoutLogs      WorkoutLog[]
  premiumPayments PremiumPayment[]
  adminSetting     AdminSetting?
}

model PremiumPayment {
  id            String        @id @default(uuid())
  userId        String
  orderId       String        @unique
  invoiceNumber String        @unique
  packageKey    String        @default("1-bulan")
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminSetting {
  id          String   @id @default(uuid())
  adminId     String   @unique
  notifEmail  Boolean  @default(true)
  notifSystem Boolean  @default(true)
  notifReport Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Instructor {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  badges    InstructorBadge[]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]
}

model Course {
  id           String            @id @default(uuid())
  createdBy    String
  instructorId String?
  activityId    String
  activity      ActivityTemplate @relation(fields: [activityId], references: [id])
  title        String
  description  String?
  about        String?
  totalDurasi  String?
  type         CourseType
  thumbnailUrl String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  creator      User              @relation("CreatedCourses", fields: [createdBy], references: [id])
  instructor   Instructor?       @relation(fields: [instructorId], references: [id])
  introVideoUrl String?
  modules      CourseModule[]
  highlights   CourseHighlight[]
  payments     Payment[]
  userCourses  UserCourse[]
  @@index([activityId])
}

model CourseHighlight {
  id       String @id @default(uuid())
  courseId String
  icon     String
  title    String
  desc     String
  order    Int    @default(0)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseModule {
  id         String      @id @default(uuid())
  courseId   String
  title      String
  durasi     String?
  order      Int
  createdAt  DateTime    @default(now())
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subModules SubModule[]
  userProgress UserModuleProgress[]

  @@index([courseId, order])
}

model SubModule {
  id       String        @id @default(uuid())
  moduleId String
  title    String
  durasi   String?
  type     SubModuleType
  order    Int
  videoUrl String?
  module   CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, order])
}

model UserModuleProgress {
  id          String       @id @default(uuid())
  userId      String
  moduleId    String
  completedAt DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model UserCourse {
  id         String           @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(active)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PaymentMethod {
  id            String    @id @default(uuid())
  name          String
  category      String
  accountNumber String?
  accountName   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  payments      Payment[]
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  courseId        String
  paymentMethodId String
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  proofUrl        String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityTemplate {
  id            String       @id @default(uuid())
  name          ActivityType @unique
  category      ActivityCategory
  description   String?
  isPremiumOnly Boolean      @default(false)
  createdAt     DateTime     @default(now())
  courses       Course[]
  schedules     UserSchedule[]
}

model UserSchedule {
  id            String           @id @default(uuid())
  userId        String
  activityId    String
  scheduledAt   DateTime  
  startAt       DateTime 
  endAt         DateTime 
  intensity     Intensity
  programType   ProgramType
  alarmEnabled  Boolean          @default(false)
  status        ScheduleStatus   @default(scheduled)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  alarmAt       DateTime?
  reminderSent  Boolean          @default(false)
  notifications Notification[]
  activity      ActivityTemplate @relation(fields: [activityId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLogs   WorkoutLog[]

  @@index([userId, scheduledAt])
  @@index([alarmAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  scheduleId String?
  title      String
  message    String
  type       NotificationType
  isRead     Boolean          @default(false)
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  schedule   UserSchedule?    @relation(fields: [scheduleId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id              String       @id @default(uuid())
  userScheduleId  String
  userId          String
  durationMinutes Int
  notes           String?
  completedAt     DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSchedule    UserSchedule @relation(fields: [userScheduleId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

enum CourseType {
  free
  premium
}

enum EnrollmentStatus {
  active
  completed
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ActivityCategory {
  workout
  recovery
  rest
  sport
}

enum Intensity {
  light
  medium
  heavy
}

enum ScheduleStatus {
  scheduled
  active
  completed
  skipped
}

enum NotificationType {
  reminder
  system
  payment
}

enum ProgramType {
  TRAINING
  COMPETITION
  RECOVERY
}

enum ActivityType {
  ANGGAR
  LARI
  RENANG
  TEMBAK
  OBSTACLE
  PIJAT
  MANDI_ES
  ISTIRAHAT_AKTIF
}

enum SubModuleType {
  video
  drill
}

enum InstructorBadge {
  ID
  SG
  MY
  AU
  GO
  FR
  US
}