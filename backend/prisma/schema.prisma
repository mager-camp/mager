generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id               String         @id @default(uuid())
  roleId           Int
  fullName         String
  email            String         @unique
  phone            String?
  passwordHash     String
  profilePicture   String?
  isPremium        Boolean        @default(false)
  premiumExpiredAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  createdCourses   Course[]       @relation("CreatedCourses")
  notifications    Notification[]
  payments         Payment[]
  role             Role           @relation(fields: [roleId], references: [id])
  userCourses      UserCourse[]
  schedules        UserSchedule[]
  workoutLogs      WorkoutLog[]
}

model Course {
  id           String       @id @default(uuid())
  createdBy    String
  title        String
  description  String?
  type         CourseType
  price        Decimal      @db.Decimal(12, 2)
  thumbnailUrl String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  creator      User         @relation("CreatedCourses", fields: [createdBy], references: [id])
  payments     Payment[]
  userCourses  UserCourse[]
}

model UserCourse {
  id         String           @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(active)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PaymentMethod {
  id            String    @id @default(uuid())
  name          String
  category      String
  accountNumber String?
  accountName   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  payments      Payment[]
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  courseId        String
  paymentMethodId String
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  proofUrl        String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityTemplate {
  id            String           @id @default(uuid())
  name          String           @unique
  category      ActivityCategory
  description   String?
  isPremiumOnly Boolean          @default(false)
  createdAt     DateTime         @default(now())
  schedules     UserSchedule[]
}

model UserSchedule {
  id            String           @id @default(uuid())
  userId        String
  activityId    String

  scheduledAt   DateTime

  alarmAt       DateTime?

  intensity     Intensity
  programType   String

  alarmEnabled  Boolean          @default(false)
  status        ScheduleStatus   @default(pending)

  notes         String?

  reminderSent  Boolean          @default(false)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  notifications Notification[]
  activity      ActivityTemplate @relation(fields: [activityId], references: [id])
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLogs   WorkoutLog[]

  @@index([userId, scheduledAt])
  @@index([alarmAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  scheduleId String?
  title      String
  message    String
  type       NotificationType
  isRead     Boolean          @default(false)
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  schedule   UserSchedule?    @relation(fields: [scheduleId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id              String       @id @default(uuid())
  userScheduleId  String
  userId          String
  durationMinutes Int
  caloriesBurned  Int?
  distanceKm      Decimal?     @db.Decimal(5, 2)
  notes           String?
  completedAt     DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSchedule    UserSchedule @relation(fields: [userScheduleId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

enum CourseType {
  regular
  premium
}

enum EnrollmentStatus {
  active
  completed
  expired
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum ActivityCategory {
  workout
  sport
  recovery
  rest
}

enum Intensity {
  light
  medium
  heavy
}

enum ScheduleStatus {
  pending
  completed
  skipped
}

enum NotificationType {
  reminder
  system
  payment
}
